node_modules/
dist/
dist-electron/
.turbo/
*.local
.DS_Store
scripts/capture-tokens/.capture/
scripts/capture-tokens/raw-*.json
coverage/
playwright-report/
test-results/
packages/ui/build/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# local packaging output
apps/desktop/release/

# corp/pi e2e run artifacts (logs, screenshots, game builds) — never committed
.corp-runs/

# GenOffice seam bundle — generated by scripts/build-genoffice.mjs
vendor/genoffice/embed/out/

# Agent worktrees (each is its own clone; never part of a commit here)
.claude/worktrees/

# Recorded frames — the video is the artefact, not the thousands of PNGs
scratchpad/mac-video/frames/
scratchpad/mac-video/frames.txt
# Every recording probe writes the same pair. The MP4 is the artefact worth
# keeping; the hundreds of PNGs it was assembled from are not, and 1173 of them
# went in on one `git add -A`.
scratchpad/mac-video-*/frames/
scratchpad/mac-video-*/frames.txt
# Demo runs are the same shape. MEASURED: 97 GB of intermediate JPEGs had piled
# up under scratchpad/demos — the mp4 beside them is the artefact.
scratchpad/demos/*/frames/
scratchpad/demos/*/frames.txt


# Session screenshot dumps. Probes produce hundreds of megabytes of PNGs; the
# few that are evidence get referenced from a report or a commit message, and
# the rest do not belong in anyone's clone.
scratchpad/cu-agentA/
scratchpad/mac-video/
scratchpad/macmon-ax/
scratchpad/mac-monitor-shots/
scratchpad/gen-cards/
scratchpad/edit-anim/
scratchpad/activity-tab/
scratchpad/round21-items-1-7-8/

scratchpad/mac-video-model/frames/
scratchpad/mac-video-model/frames.txt

# Demo/benchmark recordings: the individual FRAMES are build output — a single
# run writes tens of thousands of JPEGs, and `git add -A` put 128,070 of them
# into this repo before anyone noticed. The assembled .mp4 and the run log are
# small and worth keeping; the frames are not.
scratchpad/demos/*/frames/
scratchpad/demos/*/frames.txt
scratchpad/capture-probe/

# Python bytecode from the office pipeline running in-tree
__pycache__/
