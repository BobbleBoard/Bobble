+    def encode(self, prompt: str) -> tuple[mx.array, mx.array]:
+        """Condition on ``prompt`` once, for ``generate_array(conditioning=...)``.
+
+        The encoder is the heavy part of a run: a ~16B MoE, evicted after it
+        runs. Its output is two small arrays, so passing them to every
+        ``generate_array`` call for the prompt makes N seeds cost one encode.
+        """
+        return self._encode(prompt)
+
+    @staticmethod
+    def _validate(
+        *, width: int, height: int, steps: int, guidance: float, num_images: int = 1
+    ) -> None:
+        validate_dimensions(width=width, height=height)
+        if steps < 1:
+            raise ValueError(f"steps must be at least 1, got {steps}")
+        if num_images < 1:
+            raise ValueError(f"num_images must be at least 1, got {num_images}")
+        if guidance != 1.0:
+            raise ValueError(
+                "Ming-Image-0.1-Design is trained for guidance 1.0 (CFG off)"
+            )
+
+    def generate_seeds(
+        self,
+        prompt: str,
+        seeds: Iterable[int],
+        *,
+        steps: int = 12,
+        width: int = 1024,
+        height: int = 1024,
+        guidance: float = 1.0,
+        on_step: Callable[[int, int], None] | None = None,
+    ) -> Iterator[tuple[int, mx.array]]:
+        """Yield ``(seed, image)`` for each seed, encoding ``prompt`` only once.
+
+        Each ``[H, W, 4]`` image is exactly what ``generate_array(prompt,
+        seed=seed)`` returns alone: every seed draws its own noise, so a seed
+        reproduces the same picture whatever it was generated beside. Images
+        arrive one at a time, so a caller can save each as it is decoded.
+        Arguments are checked here; the encode runs on the first ``next``.
+        """
+        seeds = [int(seed) for seed in seeds]
+        if not seeds:
+            raise ValueError("generate_seeds needs at least one seed")
+        self._validate(width=width, height=height, steps=steps, guidance=guidance)
+        options = dict(
+            steps=steps, width=width, height=height, guidance=guidance, on_step=on_step
+        )
+        return self._seed_images(prompt, seeds, options)
+
+    def _seed_images(
+        self, prompt: str, seeds: list[int], options: dict
+    ) -> Iterator[tuple[int, mx.array]]:
+        conditioning = self.encode(prompt)
+        for seed in seeds:
+            yield seed, self.generate_array(
+                prompt, seed=seed, conditioning=conditioning, **options
+            )
